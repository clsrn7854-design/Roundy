# Roundy 환경 변수 예시
# 이 파일을 복사해 .env를 만들고 실제 값을 채운다. .env는 Git에 올리지 않는다.

# ===== 공공데이터포털 (data.go.kr) =====
# 기상청 단기예보·초단기실황·기상특보, 에어코리아, 두루누비는 같은 계정 인증키를 쓴다.
# 마이페이지에 나오는 "일반 인증키(Decoding)" 값을 넣는다.
DATA_GO_KR_SERVICE_KEY=

# ===== 카카오 (developers.kakao.com) =====
# REST API 키: 백엔드에서 장소 검색에 사용 (브라우저에 노출하지 않음)
KAKAO_REST_API_KEY=
# JavaScript 키: 프론트엔드 지도 표시에 사용 (Vite는 VITE_로 시작하는 변수만 브라우저에 넘긴다)
VITE_KAKAO_JS_KEY=

# ===== AI =====
ANTHROPIC_API_KEY=
# 6주차 모델 비교용
OPENAI_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ===== 로컬 DB (Docker Compose 기준) =====
POSTGRES_USER=roundy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roundy
# 호스트에서 접속할 때 주소. 포트 5433은 docker-compose.yml 참고 (컨테이너 안에서는 compose가 덮어씀)
DATABASE_URL=postgresql+asyncpg://roundy:change-me@localhost:5433/roundy

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/0

# ===== 인증 =====
# 아무 긴 무작위 문자열. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# ===== 서버 =====
CORS_ORIGINS=http://localhost:5173
# 프론트엔드가 호출할 백엔드 주소
VITE_API_BASE_URL=http://localhost:8000
